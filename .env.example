# Only needed for pulling private league data (Phase 5).
ESPN_S2=
ESPN_SWID=
ESPN_LEAGUE_ID=
ESPN_SEASON=2027
# Your ESPN team id in the league above (src.ops.nightly, src.inseason, and the draft board's
# live-sync sidebar all read this; `python -m src.ops.nightly --set-team N` also saves it to
